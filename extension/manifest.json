{
  "manifest_version": 3,
  "name": "Feedability に追加",
  "description": "見ているページのフィードを購読したり、ページをあとで読むに入れたりします（デスクトップアプリの Feedability へ）。",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Feedability に追加",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": ["http://127.0.0.1:41630/*"]
}
