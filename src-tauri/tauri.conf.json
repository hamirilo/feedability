{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Feedability",
  "version": "0.6.0",
  "identifier": "com.local.feedability",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Feedability",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 26 }
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true,
    "resources": { "../extension/": "extension/" },
    "fileAssociations": [
      {
        "ext": ["opml"],
        "name": "OPML",
        "description": "OPML（購読の一覧）",
        "role": "Viewer",
        "mimeType": "text/x-opml"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIyODY2QzQ4Mzc3MzRCRDgKUldUWVMzTTNTR3lHSWdwT3lSLzFYWHBMUHU3UVJrZEtOdTlGKzZoWWx1WVNlR2NyZXI3RlEzc1EK",
      "endpoints": ["https://github.com/hamirilo/feedability/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    },
    "deep-link": {
      "desktop": { "schemes": ["feed"] }
    }
  }
}
